6GHz APs cannot use WPA2-PSK. Keep the CI's password-protected default
by selecting WPA3-SAE only for detected 6GHz radios. The upstream hostapd
integration already selects required PMF and enables SAE H2E for SAE.
Do not change regulatory settings, band detection or retained UCI config.

--- a/package/network/config/wifi-scripts/files/lib/wifi/mac80211.uc
+++ b/package/network/config/wifi-scripts/files/lib/wifi/mac80211.uc
@@ -135,5 +135,5 @@
 set ${si}.mode='ap'
 set ${si}.ssid='${defaults?.ssid || 'OWRT'}'
-set ${si}.encryption='${defaults?.encryption || 'psk2+ccmp'}'
+set ${si}.encryption='${band_name == '6g' ? 'sae' : (defaults?.encryption || 'psk2+ccmp')}'
 set ${si}.key='${defaults?.key || '12345678'}'
 set ${si}.disabled='0'
