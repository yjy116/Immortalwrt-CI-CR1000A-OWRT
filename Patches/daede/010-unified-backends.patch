diff --git a/luci-app-daede/htdocs/luci-static/resources/view/daede/backend.js b/luci-app-daede/htdocs/luci-static/resources/view/daede/backend.js
index f141f74..4715fb0 100644
--- a/luci-app-daede/htdocs/luci-static/resources/view/daede/backend.js
+++ b/luci-app-daede/htdocs/luci-static/resources/view/daede/backend.js
@@ -39,8 +39,11 @@ const BACKENDS = {
 };
 
 function execOk(cmd, args) {
-	return L.resolveDefault(fs.exec(cmd, args || []), { code: 1 }).then(function(res) {
-		return res && res.code === 0;
+	return fs.exec(cmd, args || []).then(function(res) {
+		// pidof returns 1 for no process; transport/command failures are not OFF.
+		if (!res || (res.code !== 0 && res.code !== 1))
+			throw new Error(res && (res.stderr || res.stdout) || 'Process status failed');
+		return res.code === 0;
 	});
 }
 
@@ -92,16 +95,42 @@ function loadActiveBackend() {
 	});
 }
 
+function execChecked(cmd, args) {
+	return fs.exec(cmd, args).then(function(res) {
+		if (!res || res.code !== 0)
+			throw new Error(res && (res.stderr || res.stdout) || 'Command failed: ' + cmd);
+		return res;
+	});
+}
+
+function disableBackend(name) {
+	return execChecked('/sbin/uci', ['set', name + '.config.enabled=0'])
+		.then(function() { return execChecked('/sbin/uci', ['commit', name]); })
+		.then(function() { return execChecked(BACKENDS[name].initd, ['disable']); });
+}
+
 function setActiveBackend(name) {
 	if (!BACKENDS[name])
 		return Promise.reject(new Error('invalid backend: ' + name));
 
-	return exists('/etc/config/daede').then(function(ok) {
+	return detectRunning().then(function(running) {
+		if (running.dae || running.daed)
+			throw new Error('Stop both backends before switching.');
+		return detectInstalledBackends();
+	}).then(function(installed) {
+		if (!installed[name])
+			throw new Error('Backend is not installed: ' + name);
+		// Persist OFF for both, including stopped services still enabled at boot.
+		return ['dae', 'daed'].filter(function(key) { return installed[key]; })
+			.reduce(function(chain, key) {
+				return chain.then(function() { return disableBackend(key); });
+			}, Promise.resolve());
+	}).then(function() { return exists('/etc/config/daede'); }).then(function(ok) {
 		if (!ok)
 			return fs.write('/etc/config/daede', '');
-	}).then(function() { return fs.exec('/sbin/uci', ['set', 'daede.config=daede']); })
-		.then(function() { return fs.exec('/sbin/uci', ['set', 'daede.config.active_backend=' + name]); })
-		.then(function() { return fs.exec('/sbin/uci', ['commit', 'daede']); })
+	}).then(function() { return execChecked('/sbin/uci', ['set', 'daede.config=daede']); })
+		.then(function() { return execChecked('/sbin/uci', ['set', 'daede.config.active_backend=' + name]); })
+		.then(function() { return execChecked('/sbin/uci', ['commit', 'daede']); })
 		.then(function() { uci.set('daede', 'config', 'active_backend', name); });
 }
 
